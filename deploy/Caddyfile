{
	servers {
		# cloudflare proxies
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

{$DOMAIN} {
	# Cloudflare Origin CA certificate (SSL/TLS > Origin Server in the Cloudflare dashboard)
	tls /certs/origin.pem /certs/origin.key

	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8000 {
			# overwrite rather than append, so the API rate-limits on the IP Caddy resolved above
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle {
		root * /srv
		# Vite fingerprints everything under /assets, so it can be cached forever
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
